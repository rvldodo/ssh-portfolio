# Caddy terminates HTTPS (free, auto-renewing Let's Encrypt certificates)
# and forwards web traffic to the portfolio's internal HTTP port.
# SSH (port 22) does not go through Caddy; Docker maps it straight to the app.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy portfolio:8080
}

# www.<domain> is a subdomain of the same domain, not a second domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
